# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres (Prisma) – use the pooler URL for runtime, direct for migrations
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Mapbox (public token, restrict to your domain in production)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-token"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-key"
CLOUDINARY_API_SECRET="your-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="lille-liv-unsigned"

# Stripe (future premium tier)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Aula encryption key (32-byte base64) — used by Supabase Vault wrapper
AULA_ENCRYPTION_KEY=""
